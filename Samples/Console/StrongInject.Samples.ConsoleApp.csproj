<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Configurations>Debug;Release;Wpf;All</Configurations>
    <!-- CA analyzers that are noise in sample/demo code; shipped code keeps full CA rigor. -->
    <NoWarn>$(NoWarn);CA1052;CA1062;CA1724;CA1822;CA1850;CA1852;CA1861;CA5351;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Confluent.Kafka" Version="1.5.2" />
    <PackageReference Include="StrongInject" Version="$(StrongInjectSampleVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="docker-compose.yml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
