<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <Configurations>Debug;Release;AndroidApp;Wpf;All</Configurations>
    <TargetPlatformVersion>10.0.17763.0</TargetPlatformVersion>
    <!-- CA analyzers that are noise in sample/demo code; shipped code keeps full CA rigor. -->
    <NoWarn>$(NoWarn);CA1031;CA1054;CA1062;CA1063;CA1805;CA1822;CA1859;CA2000;CA2234</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StrongInject" Version="$(StrongInjectSampleVersion)" />
    <PackageReference Include="System.Collections.Immutable" Version="5.0.0" />
    <PackageReference Include="Xamarin.Forms" Version="4.8.0.1451" />
    <PackageReference Include="Xamarin.Essentials" Version="1.5.3.2" />
  </ItemGroup>

</Project>
