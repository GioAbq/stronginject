<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <Configurations>Debug;Release;Wpf;All</Configurations>
    <!-- CA analyzers that are noise in sample/demo code; shipped code keeps full CA rigor. -->
    <NoWarn>$(NoWarn);CA1033;CA1052;CA1062;CA1063;CA1305;CA1716;CA1816;CA1848;CA1873;CA2254;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StrongInject.Extensions.DependencyInjection.AspNetCore" Version="$(StrongInjectSampleVersion)" />
  </ItemGroup>


</Project>
