<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <Configurations>Debug;Release;Wpf;All</Configurations>
    <RootNamespace>StrongInject.Generator.Tests.Unit</RootNamespace>
    <!-- CA analyzers that are noise in test code; shipped code keeps full CA rigor. -->
    <NoWarn>$(NoWarn);CA1002;CA1012;CA1062;CA1305;CA1307;CA1707;CA1815;CA1829;CA1851;CA1860;CA2000;CA2012</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="6.0.0-alpha0001" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.0.0-6.final" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="16.8.0-preview-20200812-03" />
    <PackageReference Include="xunit" Version="2.4.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.4.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StrongInject\StrongInject.csproj" />
    <ProjectReference Include="..\StrongInject.Generator.Roslyn40\StrongInject.Generator.Roslyn40.csproj" />
  </ItemGroup>

</Project>
