<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <Configurations>Debug;Release;Wpf;All</Configurations>
    <!-- CA analyzers that are noise in this dev-only test-updating utility; shipped code keeps full CA rigor. -->
    <NoWarn>$(NoWarn);CA1062;CA1305;CA1307;CA1310;CA1724;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.runner.utility" Version="2.4.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\StrongInject.Tests.Unit\StrongInject.Tests.Unit.csproj" />
    <ProjectReference Include="..\..\StrongInject\StrongInject.csproj">
      <SetTargetFramework>TargetFramework=netstandard2.0</SetTargetFramework>
    </ProjectReference>
  </ItemGroup>

</Project>
