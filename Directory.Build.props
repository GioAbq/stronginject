<Project>
	<PropertyGroup>
		<LangVersion>preview</LangVersion>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<!-- CA1515/CA1034/CA2007: opinionated/preview analyzers absent from shipped runtime;
		     library exposes public API by design, ConfigureAwait is irrelevant in the generator/tests. -->
		<NoWarn>CS1591;RS1024;CA1515;CA1034;CA2007</NoWarn>
		<!-- NETSDK1138: net6.0 is intentionally targeted for compatibility; its EOL warning must not break the build. -->
		<WarningsNotAsErrors>AD0001;NETSDK1138</WarningsNotAsErrors>
		<!-- Code-style (IDExxxx) is not enforced at build time: there is no auto-formatter step,
		     so style stays an editor/IDE concern. Code-quality (CA) analyzers remain fully enforced. -->
		<EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
		<AnalysisMode>AllEnabledByDefault</AnalysisMode>
		<AnalysisLevel>preview</AnalysisLevel>
		<EnableNETAnalyzers>true</EnableNETAnalyzers>
		<StrongInjectVersion>2.0.0</StrongInjectVersion>
		<StrongInjectSampleVersion>*-*</StrongInjectSampleVersion>
	</PropertyGroup>

	<PropertyGroup>
		<Authors>StrongInject</Authors>
		<Product>StrongInject</Product>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/YairHalberstadt/stronginject</PackageProjectUrl>
		<RepositoryUrl>https://github.com/YairHalberstadt/stronginject</RepositoryUrl>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageIcon>logo-circle.png</PackageIcon>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.0.0" PrivateAssets="All"/>
	</ItemGroup>

	<ItemGroup>
		<SourceRoot Include="$(MSBuildThisFileDirectory)/"/>
		<None Include="..\resources\logo-circle.png">
			<Pack>True</Pack>
			<PackagePath></PackagePath>
		</None>
	</ItemGroup>
</Project>
